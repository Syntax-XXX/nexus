NODE_ENV=development
LOG_LEVEL=info

# Discord application
DISCORD_TOKEN=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_DEV_GUILD_ID=
OWNER_DISCORD_IDS=

# Public origins (no trailing slash)
NEXT_PUBLIC_APP_URL=http://localhost:3000
DASHBOARD_URL=http://localhost:3000
API_URL=http://localhost:3001
NEXT_PUBLIC_API_URL=http://localhost:3001

# Supabase
SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# Backend security (generate independent random values)
INTERNAL_SIGNING_SECRET=
TOKEN_ENCRYPTION_KEY=
TRUSTED_PROXY_CIDRS=127.0.0.1/32,::1/128
API_HOST=0.0.0.0
API_PORT=3001
PORT=3002

# Runtime
PLUGIN_DIRECTORY=../../plugins
PLUGIN_RPC_TIMEOUT_MS=10000
OTEL_EXPORTER_OTLP_ENDPOINT=

# Optional integrations
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
YOUTUBE_API_KEY=
CRAFTY_BASE_URL=
CRAFTY_API_TOKEN=

# Required for the German legal pages
LEGAL_CONTROLLER_NAME=
LEGAL_CONTROLLER_STREET=
LEGAL_CONTROLLER_POSTAL_CODE=
LEGAL_CONTROLLER_CITY=
LEGAL_CONTROLLER_COUNTRY=Deutschland
LEGAL_CONTACT_EMAIL=
LEGAL_PRIVACY_EMAIL=
LEGAL_REPRESENTATIVE=
LEGAL_DATA_PROTECTION_OFFICER=
