{
  "name": "nexus",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": ["apps/*", "packages/*", "plugins/*"],
  "packageManager": "pnpm@10.15.1",
  "engines": { "node": ">=20.19.0" },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --parallel",
    "dev:bot": "pnpm --filter @nexus/bot dev",
    "start": "node scripts/bonto-start.mjs",
    "start:bot": "node scripts/bonto-start.mjs bot",
    "start:api": "node scripts/bonto-start.mjs api",
    "start:worker": "node scripts/bonto-start.mjs worker",
    "dev:dashboard": "pnpm --filter @nexus/dashboard dev",
    "dev:api": "pnpm --filter @nexus/api dev",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:e2e": "pnpm --filter @nexus/dashboard test:e2e",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:migrate": "supabase db push",
    "db:reset": "supabase db reset",
    "db:generate": "supabase gen types typescript --local > packages/database/src/generated.ts",
    "db:seed": "supabase db reset",
    "db:lint": "supabase db lint",
    "clean": "turbo run clean"
  },
  "devDependencies": {
    "@eslint/js": "9.34.0",
    "@types/node": "22.18.0",
    "eslint": "9.34.0",
    "eslint-config-prettier": "10.1.8",
    "globals": "16.3.0",
    "prettier": "3.6.2",
    "supabase": "2.116.0",
    "tsx": "4.23.12",
    "turbo": "2.10.12",
    "typescript": "5.9.3",
    "typescript-eslint": "8.41.0",
    "vitest": "4.1.11"
  }
}
